#include "stm32f401xx.h"
#include "stm32f401xx_gpio_driver.h"
#include <stdint.h>


//simple software delay
void delay_ms(uint32_t ms)
{
	uint32_t count = ms * 4000;
	for(uint32_t i = 0; i < count; i++);

}





#if !defined(__SOFT_FP__) && defined(__ARM_FP)
  #warning "FPU is not initialized, but the project is compiling for an FPU. Please initialize the FPU before use."
#endif

int main(void)
{
	GPIO_Handle_t LED1, LED2, LED3, LED4, BUZZER, BUTTON;

	//Enable GPIO clock
	GPIO_PeriClockControl(GPIOA, ENABLE);
	GPIO_PeriClockControl(GPIOC, ENABLE);

	//  LED1--- PA4
	LED1.pGPIOx = GPIOA;
	LED1.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_4;
	LED1.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
	LED1.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	LED1.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	LED1.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&LED1);

	//  LED2 --- PA5
	LED2.pGPIOx = GPIOA;
	LED2.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_5;
	LED2.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
	LED2.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	LED2.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	LED2.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&LED2);

	//  LED2 --- PA6
	LED3.pGPIOx = GPIOA;
	LED3.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_6;
	LED3.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
	LED3.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	LED3.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	LED3.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&LED3);


	//  LED2 --- PA7
	LED4.pGPIOx = GPIOA;
	LED4.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_7;
	LED4.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
	LED4.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	LED4.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	LED4.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&LED4);

	// BUZZER --- PA8
	BUZZER.pGPIOx = GPIOA;
	BUZZER.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_8;
	BUZZER.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
	BUZZER.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	BUZZER.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
	BUZZER.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

	GPIO_Init(&BUZZER);

	// BUTTON --- PC13
	BUTTON.pGPIOx = GPIOC;
	BUTTON.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_13;
	BUTTON.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
	BUTTON.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
	BUTTON.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;

	GPIO_Init(&BUTTON);

	uint8_t count = 0;

	while(1)
	{
		// Check reset button
		if(GPIO_ReadFromInputPin(GPIOC, GPIO_PIN_NO_13) == 0)
		{
			count = 0;

			// Turn OFF all LEDs
			GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_4, 0);
			GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_5, 0);
			GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_6, 0);
			GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_7, 0);

			delay_ms(200); // debounce
		}

		// Binary output
		GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_4, (count >> 0) & 0x01);
		GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_5, (count >> 1) & 0x01);
		GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_6, (count >> 2) & 0x01);
		GPIO_WriteToOutputPin(GPIOA, GPIO_PIN_NO_7, (count >> 3) & 0x01);


		delay_ms(500);

		count++;

		if(count > 15)
		{
			count = 0;
		}


	}






}
